<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.PasswordField?>

<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f7f9; -fx-padding: 30;" xmlns="https://www.google.com/search?q=http://javafx.com/javafx/17" xmlns:fx="https://www.google.com/search?q=http://javafx.com/fxml/1" fx:controller="org.example.reto2.controller.LoginController">
    <children>
        <Label text="Inicio de Sesión" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <VBox spacing="10.0">
            <children>
                <Label text="Usuario:" textFill="#34495e" />
                <TextField fx:id="txtUsuario" promptText="Nombre de usuario" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                <Label text="Contraseña:" textFill="#34495e" />
                <PasswordField fx:id="txtContrasena" promptText="Contraseña" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                <Label fx:id="lblMensaje" minHeight="20.0" textFill="#e74c3c">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Button onAction="#handleLogin" prefWidth="200.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;" text="Iniciar Sesión" />
                <Button onAction="#handleCerrarAplicacion" prefWidth="200.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;" text="Cerrar Aplicación" />
            </children>
        </VBox>
    </children>
</VBox>
