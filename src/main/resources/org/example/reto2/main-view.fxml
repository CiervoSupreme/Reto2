<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>

<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #ecf0f1;" xmlns="https://www.google.com/search?q=http://javafx.com/javafx/17" xmlns:fx="https://www.google.com/search?q=http://javafx.com/fxml/1" fx:controller="org.example.reto2.controller.PrincipalController">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Mi Colección de Películas" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label fx:id="lblUsuario" text="Colección de: [Usuario]" textFill="#bdc3c7">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Listado de Copias (Doble Clic para Detalle/Modificar)" textFill="#34495e">
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                </Label>
                <TableView fx:id="tvCopias" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitulo" prefWidth="350.0" text="Película" />
                        <TableColumn fx:id="colEstado" prefWidth="200.0" text="Estado" />
                        <TableColumn fx:id="colSoporte" prefWidth="200.0" text="Soporte" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #bdc3c7; -fx-padding: 10;">
                    <children>
                        <Button onAction="#handleAnadirCopia" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="➕ Añadir Copia" />
                        <Button onAction="#handleEliminarCopia" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="🗑️ Eliminar Copia Seleccionada" />
                        <Button fx:id="btnNuevaPelicula" onAction="#handleAnadirPelicula" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="🎬 Añadir Película (Admin)" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10;">
                    <children>
                        <Button onAction="#handleCerrarSesion" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="↩️ Cerrar Sesión" />
                        <Button onAction="#handleCerrarAplicacion" style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" text="❌ Cerrar Aplicación" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
